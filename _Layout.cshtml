<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ResumeForge</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar rf-nav no-print">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">ResumeForge</a>
        <div class="ms-auto d-flex gap-2 align-items-center flex-wrap">
            @if (User.Identity.IsAuthenticated)
            {
                <span class="text-white-50 d-none d-md-inline">Hi, @User.Identity.Name</span>
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-sm btn-rf" asp-controller="Admin" asp-action="Index">Admin panel</a>
                }
                else
                {
                    <a class="btn btn-sm btn-rf" asp-controller="Resume" asp-action="Index">My resumes</a>
                }
                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Switch account</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button class="btn btn-sm btn-outline-light">Log out</button>
                </form>
            }
            else
            {
                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="btn btn-sm btn-rf" asp-controller="Account" asp-action="Register">Sign up</a>
            }
        </div>
    </div>
</nav>
<main class="container my-4">
    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success py-2 no-print">@TempData["Msg"]</div>
    }
    @RenderBody()
</main>
<footer class="app-footer">
  <div class="container">
    ResumeForge<span class="sep">|</span>Developed by <strong>Khuman Ritu</strong>
  </div>
</footer>
</body>
</html>
