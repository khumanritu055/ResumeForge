@model LoginVm
@{ ViewData["Title"] = "Log in"; }
<div class="row justify-content-center"><div class="col-md-5">
<div class="card rf-card"><div class="card-body">
    <h4 class="mb-3">Log in</h4>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" type="password" class="form-control" /></div>
        <button class="btn btn-rf w-100">Log in</button>
    </form>
    <p class="text-center mt-3 mb-0"><a asp-action="Register">New here? Create an account</a></p>
</div></div></div></div>
