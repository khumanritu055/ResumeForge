@model List<Resume>
@{ ViewData["Title"] = "My resumes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">My resumes</h4>
    <a class="btn btn-rf" asp-action="Create">Create resume</a>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-light border">You have no resumes yet. Create your first one.</div>
}
@foreach (var r in Model)
{
    <div class="card rf-card mb-2"><div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <strong>@r.Title</strong> <span class="badge text-bg-light border">@r.Template</span>
            <div class="text-muted small">@r.FullName - saved @r.CreatedAt.ToString("dd MMM yyyy")</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-rf" asp-action="Preview" asp-route-id="@r.Id">Preview and PDF</a>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
            <form asp-action="Delete" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Delete this resume?');">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </div>
    </div></div>
}
